rules_version = '2';

// Règles provisoires : tout est refusé par défaut tant que le modèle
// d'accès définitif (scanner anonyme vs dashboard admin) n'a pas été
// conçu dans l'étape "sécurité Firestore" dédiée. Ne pas déployer un
// accès public en lecture/écriture sans repasser par cette étape.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
